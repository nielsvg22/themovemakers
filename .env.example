# Database
DATABASE_URL="postgresql://user:password@localhost:5432/themovemaker?schema=public"
# Optioneel: directe verbinding voor migraties (Neon/Vercel zet deze automatisch)
# DATABASE_URL_UNPOOLED=""

# Eerste admin-account; wordt bij `npm run vercel-build` / `npm run db:bootstrap-admin`
# eenmalig aangemaakt als het nog niet bestaat. Wachtwoord minimaal 12 tekens.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (configure when needed)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="The Move Maker <noreply@themovemaker.nl>"

# Jobboard API Keys (configure when available)
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# INDEED_API_KEY=""
# INDEED_PUBLISHER_ID=""
# NATIONALE_VACATUREBANK_API_KEY=""
# JOBBIRD_API_KEY=""